{
  // Worker and hosts: the browser side, with DOM and chrome types.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["chrome", "@crxjs/vite-plugin/client", "vite/client"]
